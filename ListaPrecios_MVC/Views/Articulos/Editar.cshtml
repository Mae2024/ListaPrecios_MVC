@model ListaPrecios_MVC.Models.Articulo
@{
    ViewData["Title"] = "Editar artículo";
}

<h2>Editar artículo</h2>
<p class="text-muted">Proveedor: <strong>@Model.Proveedor</strong></p>

<form asp-action="Editar" asp-route-id="@Model.Id" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label class="form-label">Descripción</label>
        <input name="descripcion" value="@Model.Descripcion" class="form-control" required />
    </div>
    <div class="row g-2 mb-3">
        <div class="col">
            <label class="form-label">Precio sin IVA</label>
            <input name="precioSinIva" type="number" step="0.01" min="0"
                   value="@Model.PrecioSinIva.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                   class="form-control" />
        </div>
        <div class="col">
            <label class="form-label">Precio final</label>
            <input name="precioFinal" type="number" step="0.01" min="0.01"
                   value="@Model.PrecioFinal.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                   class="form-control" required />
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label">Clave</label>
        <input name="clave" type="password" class="form-control" required />
    </div>

    <button class="btn btn-primary">Guardar</button>
    <a asp-action="Index" asp-route-buscar="@Model.Descripcion" class="btn btn-secondary">Cancelar</a>
</form>