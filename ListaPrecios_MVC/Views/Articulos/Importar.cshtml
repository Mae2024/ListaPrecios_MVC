@{
    ViewData["Title"] = "Importar lista";
}

<h2>Importar lista de precios</h2>
<p>Excel con columnas: DESCRIPCION | P. SIN IVA | P. FINAL (primera fila = títulos)</p>

<form asp-action="Importar" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label class="form-label">Proveedor</label>
        <input name="proveedor" class="form-control" required />
    </div>
    <div class="mb-3">
        <input type="file" name="archivo" accept=".xlsx" class="form-control" required />
    </div>
 
    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" name="reemplazar" value="true" id="reemplazar" />
        <label class="form-check-label" for="reemplazar">
            <strong>Reemplazar lista completa</strong>: borra todos los artículos de este proveedor antes de importar
        </label>
    </div>

    <button class="btn btn-success">Importar</button>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</form>