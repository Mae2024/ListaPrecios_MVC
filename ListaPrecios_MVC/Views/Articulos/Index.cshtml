@model IEnumerable<ListaPrecios_MVC.Models.Articulo>
@{
    ViewData["Title"] = "Lista de Precios";
}

<h2>Buscador</h2>
@if (TempData["Resultado"] != null)
{
    <div class="alert alert-success">
        @TempData["Resultado"]
    </div>
}

<form method="get" class=" row g-2 buscador">

    <div class="col -md-6">
        <input name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Buscar Articulo..." autofocus />

    </div>

    <div class="col -md-3">
        <select name="proveedor" class="form-select">
            <option value="">Proveedor...</option>
            <option value="*" selected="@(ViewBag.Proveedor == "*")">Todos los proveedores</option>
            @foreach (var p in ViewBag.Proveedores)
            {
                <option value="@p" selected="@(p == ViewBag.Proveedor)">@p</option>
            }
        </select>
    </div>

    <div class="col-md-4">
        <button class="btn btn-primary">Filtrar</button>
        <a asp-action="Index" asp-route-proveedor="*" class="btn btn-outline-secondary">Ver todos</a>
        <a asp-action="Index" class="btn btn-secondary">Limpiar</a>
        <a asp-action="Importar" class="btn btn-success">Importar</a>


    </div>
</form>


@if (ViewBag.SinFiltro == true)
{
    <p class="text-muted">Escribí el nombre de un artículo o elegí un proveedor para ver los precios.</p>
}
else if (!Model.Any())
{
    <p class="text-muted">No se encontraron artículos.</p>
}
else
{

    <p>@Model.Count() articulos</p>


    /*tabla solo en PC*/
    <div class="d-none d-md-block">
        <table class="table table-striped table-sm">
            <thead>
                <tr>
                    <th>Descripcion</th>
                    <th>Proveedor</th>
                    <th class="text-end">Sin Iva</th>
                    <th class="text-end">Precio Final</th>
                    <th class="text-center ps-4">Actualizados</th>
                </tr>

            </thead>

            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td>@a.Descripcion</td>
                        <td>@a.Proveedor</td>
                        <td class="text-end">@a.PrecioSinIva.ToString("N2")</td>
                        <td class="text-end">@a.PrecioFinal.ToString("N2")</td>
                        <td class="text-center ps-4">@a.FechaActualizacion.ToString("dd/MM/yyyy")</td>
                        <td><a asp-action="Editar" asp-route-id="@a.Id" class="btn btn-sm btn-outline-secondary">✏️</a></td>
                    </tr>
                }

            </tbody>

        </table>
    </div>

    /*tarjetas: solo en celular*/
    <div class="d-md-none">
        @foreach (var a in Model)
        {
            <div class="art-card">
                <div class="desc">@a.Descripcion</div>
                <div class="d-flex justify-content-between align-items-end">
                    <div>
                        <div class="precio">$ @a.PrecioFinal.ToString("N2")</div>
                        <div class="detalle">
                            Sin IVA $ @a.PrecioSinIva.ToString("N2") · @a.FechaActualizacion.ToString("dd/MM/yyyy")
                        </div>
                    </div>
                    <div class="text-end">
                        <span class="badge badge-prov">@a.Proveedor</span><br />
                        <a asp-action="Editar" asp-route-id="@a.Id" class="btn btn-sm btn-outline-secondary mt-2">✏️</a>
                    </div>
                </div>
            </div>
        }
    </div>
}