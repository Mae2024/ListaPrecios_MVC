@{
    ViewData["Title"] = "Importar Clientes";
}

<h2>Importar Clientes</h2>
<p>Excel con columnas: NOMBRE | DIRECCION (primera fila = titulos)</p>

<form asp-action="Importar" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <input type="file" name="archivo" accept=".xlsx" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-check form-label">Clave</label>
        <input name="clave" type="password" class="form-control" required />
    </div>

    <button class="btn btn-primary">importar</button>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>

</form>


