@model List<ListaPrecios_MVC.Models.Cliente>
@{
    ViewData["Title"] = "Clientes";
    bool esAdmin = User.IsInRole("Admin");
}

<h2>Clientes</h2>

@if (TempData["Resultado"] != null)
{
    <div class="alert alert-success">@TempData["Resultado"]</div>
}

@* ===== Solo Admin: importar y filtrar por vendedor ===== *@
@if (esAdmin)
{
    List<Microsoft.AspNetCore.Identity.IdentityUser> vendedores = ViewBag.Vendedores;

    <p>
        <a asp-action="Importar" class="btn btn-primary">📥 Importar clientes</a>
    </p>

    <form method="get" class="d-flex gap-2 buscador">
        <select name="vendedor" class="form-select">
            <option value="">Todos los vendedores</option>
            @foreach (var v in vendedores)
            {
                <option value="@v.Id" selected="@(v.Id == ViewBag.Vendedor)">@v.UserName</option>
            }
        </select>
        <button class="btn btn-primary">Ver</button>
    </form>
}

<p>@Model.Count clientes</p>

<table class="table table-sm tabla-precios">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Dirección</th>
            @if (esAdmin)
            {
                <th>Vendedor</th>
            }
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Nombre</td>
                <td>@c.Direccion</td>
                @if (esAdmin)
                {
                    <td>@c.Vendedor?.UserName</td>
                }
            </tr>
        }
    </tbody>
</table>