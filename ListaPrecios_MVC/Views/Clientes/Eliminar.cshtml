@model ListaPrecios_MVC.Models.Cliente
@{
    ViewData["Title"] = "Eliminar Cliente";
    
}

<h2>Eliminar cliente</h2>


<div class="buscador">
    <div class="fw-bold fs-5">@Model.Nombre</div>
    <div class="text-muted">@Model.Direccion </div>
    
</div>

@if(ViewBag.CantidadPedidos > 0)
{
    <p class="alert alert-warning"> este cliente tiene <strong>@ViewBag.CantidadPedidos</strong> y no se puede borrar.</p> 
    
}
else
{
    <div class="alert alert-danger">
        ¿Seguro que querés eliminar este cliente? <strong>No se puede deshacer.</strong>
    </div>

    <form asp-action="Eliminar" asp-route-id="@Model.Id" method="post">
        <button class="btn btn-danger w-100">🗑️ Sí, eliminar cliente</button>
    </form>
}

<a asp-action="Index" class="btn btn-secondary w-100 mt-2">Cancelar</a>

